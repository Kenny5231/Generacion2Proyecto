# Plantilla de configuracion. NO la use tal cual: ejecute scripts/configure.sh,
# que genera .env con los datos reales del servidor (DNS de Tailscale).
# El archivo .env real nunca debe subirse a Git. No contiene contraseñas ni claves.
#
# Formato: CLAVE=valor (sin comillas, sin espacios, sin $).

# Version de Gitea (imagen docker.gitea.com/gitea:<version>-rootless). Siempre fija.
GITEA_VERSION=28.3.0

# Rutas en el servidor Ubuntu.
GITEA_INSTALL_DIR=/srv/gitea-privado
GITEA_BACKUP_DIR=/srv/backups/gitea-privado

# Nombre DNS de Tailscale (MagicDNS) del servidor, p. ej. <equipo>.<tailnet>.ts.net
GITEA_TS_DNS=

# Puerto HTTPS de Tailscale Serve (443, 8443 o 10000) y URL publica resultante.
GITEA_TS_HTTPS_PORT=443
GITEA_ROOT_URL=

# Dominio mostrado en las URL de clonado SSH (por defecto igual a GITEA_TS_DNS).
GITEA_SSH_DOMAIN=

# Los cuatro puertos de la arquitectura (todos configurables para evitar colisiones):
#   GITEA_WEB_PORT        HTTP de Gitea publicado SOLO en 127.0.0.1
#   GITEA_SSH_LOCAL_PORT  SSH de Gitea publicado SOLO en 127.0.0.1
#   GITEA_SSH_PORT        puerto SSH que Tailscale Serve ofrece en la tailnet (el que se anuncia al clonar)
#   GITEA_TS_HTTPS_PORT   (arriba) puerto HTTPS de Tailscale Serve
GITEA_WEB_PORT=3090
GITEA_SSH_LOCAL_PORT=2222
GITEA_SSH_PORT=2222

# Zona horaria del contenedor.
TZ=UTC

# Obsoleta (version anterior): GITEA_TAILSCALE_IP. Ya no se usa; si aparece en un .env
# antiguo se ignora. Docker no necesita la IP de Tailscale: configure.sh --regenerate la elimina.

# Opcionales (solo para pruebas de restauracion en un entorno separado):
# COMPOSE_PROJECT_NAME=gitea-privado
# GITEA_CONTAINER_NAME=gitea-privado
